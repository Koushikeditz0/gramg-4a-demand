# ---- IAY Pi Sync settings ----
# Sync key from IAY Tracker → “📡 Tampermonkey live sync” → Create sync key.
# The same key can be used by the Tampermonkey script and the Pi together.
SYNC_KEY=iay_paste_your_key_here

# Minutes between runs (15 or more). 60 = every hour.
INTERVAL_MIN=60
# Run only between these hours, India time (24-hour). Night is skipped.
ACTIVE_HOURS=6-23

# Empty = whole block (all GPs). Or a list: GPS=PETLA,OKRABARI
GPS=

# Optional: report links. Empty = the DINHATA-I links built into the script.
R42_URL=
R44_URL=
R612_URL=
# Optional: “Employment Provided” report link per GP for beneficiary names (JSON on one line).
# Without it, names already saved in the Tracker are kept.
EMP_URLS={}

# ---- Morning summary on your phone (ntfy) ----
# ntfy server on the Pi, by its LAN address (not localhost), e.g. http://192.168.0.10:2586
# Empty = no morning message.
NTFY_URL=
NTFY_TOPIC=iay-report
# Only if your ntfy needs login (access token from ntfy). Usually empty.
NTFY_TOKEN=
# India time, HH:MM
DIGEST_TIME=09:00
# Message only for one GP (sync still covers the whole block). Empty = whole block.
DIGEST_GP=
# Your public report link — tapping the message opens it
PUBLIC_URL=
